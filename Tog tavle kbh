<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Afgangstavle - Høje Taastrup</title>
    <style>
        /* DSB Stations-look */
        body { 
            background-color: #040d21; /* Mørkeblå stationsbaggrund */
            color: #ffffff; 
            font-family: 'Courier New', Courier, monospace, sans-serif; 
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .skaerm {
            width: 100%;
            max-width: 600px;
            background: #020714;
            border: 4px solid #1a2a4a;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }
        .header {
            border-bottom: 2px solid #1a2a4a;
            padding-bottom: 10px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            font-size: 0.9em;
            color: #8da2cb;
        }
        .station-navn {
            font-size: 1.5em;
            color: #ffffff;
            font-weight: bold;
            margin: 5px 0 15px 0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .tog-raekke {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #051330;
            padding: 12px;
            margin: 8px 0;
            border-radius: 4px;
            border-left: 6px solid #e30613; /* S-tog rød */
        }
        .linje-og-destination {
            display: flex;
            flex-direction: column;
        }
        .linje {
            font-weight: bold;
            color: #ffcc00; /* Klassisk gul info-farve */
            font-size: 1.2em;
        }
        .destination {
            font-size: 1.1em;
            margin-top: 2px;
        }
        .tid-og-spor {
            text-align: right;
        }
        .tid {
            font-size: 1.3em;
            font-weight: bold;
            color: #ffffff;
        }
        .forsinket {
            color: #ff3333;
        }
        .spor {
            font-size: 0.9em;
            color: #8da2cb;
            margin-top: 2px;
        }
        .ingen-tog {
            text-align: center;
            padding: 20px;
            color: #8da2cb;
        }
    </style>
</head>
<body>

    <div class="station-navn">Høje Taastrup St.</div>

    <div class="skaerm">
        <div class="header">
            <div id="klokken">00:00:00</div>
            <div>Afgange (Linje B)</div>
        </div>
        <div id="tog-liste">Henter live-data...</div>
    </div>

    <script>
        const url = "https://rejseplanen.dk";

        function opdaterKlokke() {
            const nu = new Date();
            document.getElementById('klokken').innerText = nu.toLocaleTimeString('da-DK');
        }

        async function hentTogData() {
            try {
                const response = await fetch(url);
                const data = await response.json();
                const departures = data.DepartureBoard.Departure || [];
                
                let html = "";
                let fundetTog = false;
                
                // Sorter og filtrer data
                departures.forEach(dep => {
                    if (dep.name === "S-tog B" && dep.direction.includes("Farum")) {
                        fundetTog = true;
                        const planlagtTid = dep.time;
                        const realTid = dep.rtTime;
                        const spor = dep.track || "-";
                        
                        let tidsVisning = `<span class="tid">${planlagtTid}</span>`;
                        
                        // Hvis toget er forsinket
                        if (realTid && realTid !== planlagtTid) {
                            tidsVisning = `<span class="tid forsinket">${realTid}</span> <span class="spor">(${planlagtTid})</span>`;
                        }
                        
                        html += `
                            <div class="tog-raekke">
                                <div class="linje-og-destination">
                                    <span class="linje">${dep.name}</span>
                                    <span class="destination">mod ${dep.direction}</span>
                                </div>
                                <div class="tid-og-spor">
                                    <div>${tidsVisning}</div>
                                    <div class="spor">Spor ${spor}</div>
                                </div>
                            </div>
                        `;
                    }
                });
                
                document.getElementById('tog-liste').innerHTML = fundetTog ? html : '<div class="ingen-tog">Ingen planlagte tog mod Farum lige nu</div>';
                
            } catch (error) {
                document.getElementById('tog-liste').innerHTML = '<div class="ingen-tog" style="color:#ff3333;">Fejl ved forbindelse til Rejseplanen</div>';
            }
        }

        // Udfør med det samme og sæt intervaller
        setInterval(opdaterKlokke, 1000);
        setInterval(hentTogData, 30000); // Opdaterer data hvert 30. sekund
        opdaterKlokke();
        hentTogData();
    </script>
</body>
</html>
